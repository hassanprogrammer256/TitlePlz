# Runtime
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Reverse-proxy hops in front of the app (needed for correct client IPs / rate limits in prod)
# TRUST_PROXY=1
# LOG_LEVEL=info

# Database. SQLite for dev, PostgreSQL for prod (switch with `npm run db:use`).
#   dev:  file:./dev.db
#   prod: postgresql://USER:PASSWORD@HOST:5432/titleplz?schema=public
DATABASE_URL=file:./dev.db

# Auth (JWT_SECRET must be >= 32 chars; generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Defaults to true in production, false otherwise
# COOKIE_SECURE=true

# Admins are granted with: npm run admin:grant -- <username>   (revoke: npm run admin:grant -- <username> --revoke)

# /api/credits/purchase is a stub that grants credits for free. Defaults to on outside production.
# Leave it off in production until real payments (Stripe) exist.
# ALLOW_FAKE_PURCHASES=false

# Media storage: local (dev) or s3 (any S3-compatible: AWS S3, Cloudflare R2)
STORAGE_DRIVER=local
LOCAL_MEDIA_DIR=./uploads
# PUBLIC_BASE_URL=http://localhost:4000
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=

# AI (not used in v1; server-side only)
# GEMINI_API_KEY=
