{
  "name": "titleplz_server",
  "version": "1.0.0",
  "description": "TitlePlz backend",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/server/src/server.js",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/server.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "db:sync": "tsx scripts/db.ts sync",
    "db:use": "tsx scripts/db.ts use",
    "db:generate": "npm run db:sync && prisma generate",
    "db:migrate": "npm run db:sync && prisma migrate dev",
    "db:deploy": "npm run db:sync && prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "npm run db:sync && prisma migrate reset --force",
    "db:studio": "prisma studio",
    "postinstall": "npm run db:generate",
    "admin:grant": "tsx scripts/make-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.1",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
